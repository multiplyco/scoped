{:paths ["src" "target/scoped-runtime.jar" "src-java/jdk25"]

 :deps/prep-lib {:alias :build :fn compile-java
                 :ensure "target/scoped-runtime.jar"}

 :deps  {#_#_org.clojure/clojure {:mvn/version "1.12.4"}
         #_#_org.clojure/clojurescript {:mvn/version "1.12.134"}}

 :aliases
 {:dev         {:extra-paths ["dev"]
                :extra-deps  {nrepl/nrepl {:mvn/version "1.5.1"}}}

  :test        {:extra-paths ["test"]
                :extra-deps  {org.clojure/clojure {:mvn/version "1.12.5"}
                              lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

  :bench       {:extra-paths ["bench"]
                :extra-deps  {criterium/criterium {:mvn/version "0.4.6"}}
                :jvm-opts    ["-Xms512m" "-Xmx512m"]
                :main-opts   ["-m" "co.multiply.scoped-bench"]}

  :bench-runtime {:extra-paths ["bench"]
                  :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                               criterium/criterium {:mvn/version "0.4.6"}}
                  :jvm-opts ["-Xms512m" "-Xmx512m"]
                  :main-opts ["-m" "co.multiply.scoped-runtime-bench"]}

  :bench-dev   {:extra-paths ["bench"]
                :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                             criterium/criterium {:mvn/version "0.4.6"}}
                :jvm-opts ["-Xms512m" "-Xmx512m"]
                :main-opts ["-m" "co.multiply.scoped-dev-bench"]}

  :bench-test  {:extra-paths ["bench"]
                :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                             criterium/criterium {:mvn/version "0.4.6"}}
                :main-opts ["-m" "co.multiply.scoped-bench-runner-test"]}

  :bench-profile {:extra-paths ["bench"]
                  :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                               criterium/criterium {:mvn/version "0.4.6"}}
                  :jvm-opts ["-Xms512m" "-Xmx512m"]
                  :main-opts ["-m" "co.multiply.scoped-allocation-profile"]}

  :bench-representation {:replace-paths ["bench/experiments/representation/clj"
                                        "target/bench/representation/classes"]
                         :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                                      criterium/criterium {:mvn/version "0.4.6"}}
                         :jvm-opts ["-Xms512m" "-Xmx512m"]
                         :main-opts ["-m" "co.multiply.scoped-representation-bench"]}

  :bench-batch {:replace-paths ["bench/experiments/representation/clj"
                               "target/bench/representation/classes"]
                :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                             criterium/criterium {:mvn/version "0.4.6"}}
                :jvm-opts ["-Xms512m" "-Xmx512m"]
                :main-opts ["-m" "co.multiply.scoped-batch-bench"]}

  :bench-task-slot {:replace-paths ["bench/experiments/task-slot/clj"
                                   "target/bench/task-slot/classes"]
                    :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                                 criterium/criterium {:mvn/version "0.4.6"}}
                    :jvm-opts ["-Xms512m" "-Xmx512m"]
                    :main-opts ["-m" "co.multiply.scoped-task-slot-bench"]}

  :bench-bifurcan {:replace-paths ["bench/experiments/bifurcan/clj"
                                  "target/bench/bifurcan/classes"]
                   :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                                criterium/criterium {:mvn/version "0.4.6"}
                                io.lacuna/bifurcan {:mvn/version "0.2.0-rc1"}}
                   :jvm-opts ["-Xms512m" "-Xmx512m"]
                   :main-opts ["-m" "co.multiply.scoped-bifurcan-bench"]}

  :shadow-cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "3.3.4"}}}

  :build       {:ns-default build
                :deps       {io.github.clojure/tools.build {:mvn/version "0.10.11"}
                             slipset/deps-deploy           {:mvn/version "0.2.2"}}}

  :cljdoc      {:extra-deps {io.github.cljdoc/cljdoc-analyzer {:git/tag "v1.0.873" :git/sha "bf4f620c"}}
                :main-opts  ["-m" "cljdoc-analyzer.cljdoc-main"]}}}
